  "components": {
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer" }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "schema": { "type": "integer", "default": 1 }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "schema": { "type": "integer", "default": 10 }
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "EventStatus": { "type": "integer", "enum": [1, 2, 3, 4] },
      "TicketStatus": { "type": "integer", "enum": [1, 2, 3, 4, 5] },
      "WaitlistStatus": { "type": "integer", "enum": [1, 2, 3, 4] },
      "PaymentStatus": { "type": "integer", "enum": [1, 2, 3, 4] },
      "WalletTransactionType": { "type": "integer", "enum": [1, 2, 3] },
      "LoginDto": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string" },
          "password": { "type": "string" }
